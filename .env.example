# Copy this file to .env before starting Docker Compose or the application locally.
# These values are only for development. Use a secret manager or deployment variables in production.
DB_NAME=cinema_catalog
DB_USER=postgres
DB_PASSWORD=change_me_local
# Used when running Spring Boot from the host. Compose supplies its own internal URL.
DB_URL=jdbc:postgresql://localhost:5433/cinema_catalog
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_PORT=8081
